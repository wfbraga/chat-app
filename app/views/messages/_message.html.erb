<% viewing_user_id ||= nil %>
<% styles = message_bubble_styles(message, viewing_user_id: viewing_user_id) %>

<div class="d-flex mb-3 <%= styles[:alignment] %>">
  <div class="p-3 rounded-3 mw-75"
       style="max-width: 75%; background-color: <%= styles[:bg_color] %>; color: <%= styles[:text_color] %>;">
    <div class="small fw-semibold mb-1">
      <%= message.sender.display_name %>
      <% unless styles[:is_mine] %>
        <span class="<%= role_badge_classes %>" style="<%= role_badge_style(styles[:text_color]) %>">
          <%= message.sender.role.capitalize %>
        </span>
      <% end %>
    </div>
    <div><%= message.body %></div>
    <div class="small mt-1 opacity-75">
      <%= message.created_at.strftime('%H:%M') %>
    </div>
  </div>
</div>

