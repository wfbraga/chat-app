<% is_mine = message.sender_id == current_user.id %>
<div class="d-flex mb-3 <%= is_mine ? 'justify-content-end' : 'justify-content-start' %>">
  <div class="p-3 rounded-3 mw-75"
       style="max-width: 75%; background-color: <%= is_mine ? '#0d6efd' : '#f0f0f0' %>;
         color: <%= is_mine ? 'white' : 'black' %>;">
    <div class="small fw-semibold mb-1">
      <%= message.sender.display_name %>
    </div>
    <div><%= message.body %></div>
    <div class="small mt-1 opacity-75">
      <%= message.created_at.strftime('%H:%M') %>
    </div>
  </div>
</div>