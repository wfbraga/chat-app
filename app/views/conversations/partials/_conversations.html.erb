<h4 class="mb-4">
  <%= current_user.staff? ? 'All Conversations' : 'My Conversations' %>
</h4>

<% if @conversations.empty? %>
  <p class="text-muted">No conversations yet.</p>
<% else %>
  <div class="list-group">
    <% @conversations.each do |convo| %>
      <%= link_to admin_conversation_path(convo),
                  class: "list-group-item list-group-item-action" do %>
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <span class="fw-semibold"><%= convo.user.display_name %></span>
            <span class="text-muted small ms-2"><%= convo.department.humanize %></span>
          </div>
          <div class="d-flex gap-2 align-items-center">
            <% if convo.staff %>
              <span class="badge bg-info text-dark"><%= convo.staff.display_name %></span>
            <% else %>
              <span class="badge bg-warning text-dark">Unassigned</span>
            <% end %>
            <span class="badge bg-<%= convo.open? ? 'success' : convo.closed? ? 'secondary' : 'warning' %>">
              <%= convo.status.humanize %>
            </span>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>