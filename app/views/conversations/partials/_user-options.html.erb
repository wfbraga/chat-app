<div class="row justify-content-center">
  <div class="col-md-6 text-center mt-5">
    <h2>Welcome, <%= current_user.display_name %> 👋</h2>
    <p class="text-muted">Need help? Start a conversation with our team.</p>

    <%= form_with url: conversations_path, method: :post do |f| %>
      <div class="mb-3">
        <label class="form-label fw-semibold">Who do you need to talk to?</label>
        <div class="d-grid gap-2">
          <button name="department" value="support" class="btn btn-outline-primary btn-lg">
            🛠 Customer Support
          </button>
          <button name="department" value="sales" class="btn btn-outline-success btn-lg">
            💼 Sales Team
          </button>
        </div>
      </div>
    <% end %>
  </div>
</div>