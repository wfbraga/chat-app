<%= turbo_stream_from "user_#{current_user.id}_conversation_#{@conversation.id}_messages" %>
<div class="row justify-content-center">
  <div class="col-md-8">

    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span>
          💬 Your conversation
          <span class="badge bg-<%= @conversation.open? ? 'success' : 'warning' %>">
            <%= @conversation.status.humanize %>
          </span>
        </span>
        <span class="text-muted small">
          <%= @conversation.department.humanize %> dept.
        </span>
      </div>

      <%# Messages area - we'll hook Turbo Streams here later %>
      <div class="card-body" style="height: 400px; overflow-y: auto;"
           id="messages"
           data-current-user-id="<%= current_user.id %>"
           data-controller="messages-container">
        <% if @messages %>
          <%= render partial: 'messages/message', collection: @messages, locals: { viewing_user_id: current_user.id } %>
        <% end %>
      </div>

      <div class="card-footer">
        <% unless @conversation.closed? %>
          <%= form_with url: conversation_messages_path(@conversation), method: :post, id: "new_message_form" do |f| %>
            <div class="input-group">
              <%= f.text_field :body, class: 'form-control',
                               placeholder: 'Type your message...', autocomplete: 'off' %>
              <%= f.submit 'Send', class: 'btn btn-primary' %>
            </div>
          <% end %>
        <% else %>
          <p class="text-muted text-center mb-0">This conversation is closed.</p>
        <% end %>
      </div>
    </div>

  </div>
</div>